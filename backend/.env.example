# Existing Render environment values take precedence over this local file.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/geosustain_db
SECRET_KEY=replace-with-a-long-random-secret
# Explicit trusted origins only. Add preview URLs or Flutter localhost ports here.
FRONTEND_ORIGINS=https://geosustain.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:8080
OPENWEATHER_API_KEY=your-openweather-key
GEE_PROJECT_ID=your-google-cloud-project
# GEE_SERVICE_ACCOUNT_JSON={...full service-account JSON...}
# Password login does not require Firebase or an email verification service.
