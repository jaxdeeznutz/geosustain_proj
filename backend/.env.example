# Existing Render environment values take precedence over this local file.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/geosustain_db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production refuses missing, short, or placeholder keys. Keep the existing strong key.
SECRET_KEY=replace-with-a-long-random-secret
# Set production outside Render too, to require secure session cookies.
APP_ENV=development
# Explicit trusted origins only. Add preview URLs or Flutter localhost ports here.
FRONTEND_ORIGINS=https://geosustain.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:8080
OPENWEATHER_API_KEY=your-openweather-key
GEE_PROJECT_ID=your-google-cloud-project
# GEE_SERVICE_ACCOUNT_JSON={...full service-account JSON...}
# Email signup/recovery: HTTPS transport supports the current Render Free host.
# Production defaults to required verification. This 0 is local development only.
EMAIL_VERIFICATION_REQUIRED=0
# EMAIL_TRANSPORT=resend
# MAIL_FROM=GeoSustain <verified-sender@your-owned-domain.example>
# RESEND_API_KEY=configure-privately-in-host-environment
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_FROM=GeoSustain <your-sender@example.com>
# SMTP_USERNAME=your-sender@example.com
# SMTP_PASSWORD=configure-privately-in-host-environment
# Render Free blocks SMTP ports 25/465/587. Use the HTTPS transport above there.
# Firebase Auth project shared with the client; public project identifier only.
# FIREBASE_AUTH_PROJECT_ID=your-firebase-project-id
# IDENTITY_REQUIRED=true
# Push delivery does require the project's Firebase Cloud Messaging setup.
# Keep this service-account JSON only on the backend, never in Flutter/web files.
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_SERVICE_ACCOUNT_JSON={...dedicated FCM service-account JSON...}
# PUSH_REQUIRED=true
# Durable recoverable analysis; enable on every API process in the deployment.
ANALYSIS_JOBS_ENABLED=1
# Shared PostgreSQL quotas per five-minute window, including all API processes.
QUOTA_ANALYSIS=10
QUOTA_PROVIDER_ANALYSIS=60
# Inactivity means time since the last authenticated API/web request. Absolute TTL is 24 hours.
SESSION_IDLE_SECONDS=1800
# Exact HTTPS Flutter origin for web notification clicks (no credentials/query).
# PUBLIC_WEB_APP_URL=https://your-geosustain-web-host.example
# Optional deployment pin: exact SHA-256 printed by backend/verify_model.py.
# Update together with each approved artifact release; a mismatch blocks model loading.
# GEOSUSTAIN_EXPECTED_MODEL_VERSION=6dee915ad58e55e376bcfb5a74ecee9db086491cf5fe29a1b3149f5b45be9278
