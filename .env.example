
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geosustain_db

SECRET_KEY=change-me-to-a-long-random-secret

GEE_PROJECT=capstone-493314

# Email: configure Render's private environment, or backend/.env locally.
# Render Free blocks SMTP ports 25/465/587; use a supported HTTPS provider.
# Verify the sender and enable transactional sending in your provider first.
# EMAIL_TRANSPORT=brevo
# MAIL_FROM=GeoSustain <your-verified-sender@gmail.com>
# BREVO_API_KEY=configure-privately-in-host-environment
# EMAIL_VERIFICATION_REQUIRED=1
# Resend is also supported for an owned verified sending domain:
# EMAIL_TRANSPORT=resend
# MAIL_FROM=GeoSustain <verified-sender@your-owned-domain.example>
# RESEND_API_KEY=configure-privately-in-host-environment
# For other hosts that allow TLS SMTP, use SMTP_USERNAME (not SMTP_USER).
# See backend/.env.example and deployment/IDENTITY_AND_DELIVERY_SETUP.md.



# Optional: reviewed locality Polygon/MultiPolygon GeoJSON for CAGRO matching.
# See docs/CAGRO_LOCALITY_SOIL.md. Never use circles around anchor coordinates.
CAGRO_LOCALITY_BOUNDARIES_PATH=
