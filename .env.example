
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geosustain_db

SECRET_KEY=change-me-to-a-long-random-secret

GEE_PROJECT=capstone-493314

# Email delivery for account verification codes (Gmail SMTP by default).
# SMTP_USER is the sending Gmail address; SMTP_PASSWORD must be a Gmail
# "app password" (NOT your normal Gmail password) — enable 2-Step
# Verification on that Google account, then generate one at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-app-gmail@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-app-gmail@gmail.com


